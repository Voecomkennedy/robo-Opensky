# Copie este arquivo para ".env" e preencha com os seus dados reais.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).

# Chave de acesso do OpenSky
OPENSKY_ACCESS_KEY=

# Dados da instância Z-API (WhatsApp)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Um grupo de WhatsApp por região (o robô manda cada oportunidade pro
# grupo da região certa)
ZAPI_GRUPO_CENTRO_OESTE=
ZAPI_GRUPO_SUDESTE=
ZAPI_GRUPO_NORDESTE=
ZAPI_GRUPO_SUL=
ZAPI_GRUPO_NORTE=
