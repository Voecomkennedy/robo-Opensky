# Copie este arquivo para ".env" e preencha com os seus dados reais.
# NUNCA faça commit do arquivo ".env" (ele já está no .gitignore).

# Chave de acesso do OpenSky
OPENSKY_ACCESS_KEY=

# Dados da instância Z-API (WhatsApp)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Grupo padrão: enquanto os grupos por região abaixo não forem
# preenchidos, todas as regiões mandam pra esse mesmo grupo.
WHATSAPP_GROUP_ID=

# Um grupo de WhatsApp por região (opcional, por enquanto). Preencha só
# quando quiser separar os disparos por região — enquanto estiver vazio,
# a região correspondente usa o WHATSAPP_GROUP_ID acima.
ZAPI_GRUPO_CENTRO_OESTE=
ZAPI_GRUPO_SUDESTE=
ZAPI_GRUPO_NORDESTE=
ZAPI_GRUPO_SUL=
ZAPI_GRUPO_NORTE=
